# Server-only email configuration. Never commit real credentials or use NEXT_PUBLIC_ prefixes.
# Keep all three email secrets distinct; store deployment values as sensitive secrets.
# Resend API key: sending, contact, segment and event operations.
RESEND_API_KEY=re_replace_with_resend_key
# Signing secret for delivery-feedback events; inbound email is not processed by this handler.
RESEND_WEBHOOK_SECRET=whsec_replace_with_webhook_secret
# Application-owned stable secret: existing preference links and Redis identity keys.
# Preserve the existing value. Rotation requires a migration; see docs/UPSTASH_REDIS_INTEGRATION.md.
SUBSCRIPTION_PREFERENCES_SECRET=replace_with_a_long_random_secret
# Required for confirmations, consent, suppression, subscriber coordination and email retries.
# Subscriber mutations and recipient delivery allowances fail closed without Redis.
# Only IP rate limits fall back locally; Contact delivery has no subscriber journal.
# Use the existing database's HTTPS REST endpoint and a read/write REST token.
UPSTASH_KV_REST_API_URL=https://replace_with_upstash_host.upstash.io
UPSTASH_KV_REST_API_TOKEN=replace_with_read_write_rest_token
# Server-only Stripe Checkout configuration. Prefer a restricted key with only
# the permissions documented in docs/STRIPE_INTEGRATION.md.
# Configure one key; prefer a restricted key. Leave the unused key empty.
STRIPE_RESTRICTED_KEY=
# Compatibility fallback when a restricted key is not yet available.
STRIPE_SECRET_KEY=
# Optional Resend configuration overrides.
RESEND_SEGMENT_EN=39c96ed5-94c2-4755-876a-b29b414433e0
RESEND_SEGMENT_ZH_TW=4e7fa9d7-7df1-42a9-a6d0-224f6a59b982
RESEND_SEGMENT_ZH_CN=84cc2bde-6d03-4497-b21b-84c1d4fc265e

# Optional Sentry error monitoring. Prefer Vercel Integration-managed values.
# The browser DSN is public; the upload auth token must stay server/build-only.
# Leave DSNs empty to disable monitoring locally.
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_DSN=
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=
