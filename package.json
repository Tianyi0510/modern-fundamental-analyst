{
  "name": "modern-fundamental-analyst",
  "version": "1.0.0",
  "private": true,
  "engines": {
    "node": "24.x"
  },
  "prettier": {
    "printWidth": 120,
    "plugins": [
      "prettier-plugin-tailwindcss"
    ],
    "tailwindStylesheet": "./src/app/globals.css",
    "tailwindFunctions": [
      "cn",
      "clsx",
      "cva"
    ]
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings=0 --cache --cache-location node_modules/.cache/eslint",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "npm run test:node && npm run test:unit && npm run test:integration",
    "test:unit": "vitest run --project=unit",
    "subscription:journal": "node --env-file-if-exists=.env.local --import ./scripts/register-server.mjs src/features/subscriptions/server/subscription-journal-cli.mjs",
    "test:computed-style": "playwright test --project=chromium",
    "test:webkit": "node scripts/run-webkit.mjs",
    "verify": "npm run verify:static && npm run build && npm run test:computed-style:production",
    "test:computed-style:production": "PLAYWRIGHT_USE_PRODUCTION_BUILD=1 playwright test --project=chromium",
    "email": "npm run email:contact",
    "email:contact": "email dev --dir src/features/contact/previews --port 3001",
    "email:preferences": "email dev --dir src/features/subscriptions/previews --port 3002",
    "verify:static": "npm run typecheck && npm run lint && npm run format:check && npm test",
    "prepare": "node .husky/install.mjs",
    "lint:staged": "lint-staged",
    "test:node": "node --import ./scripts/register-server.mjs --test \"src/**/*.test.mjs\" \"scripts/*.test.mjs\" \"*.test.mjs\"",
    "test:integration": "vitest run --project=integration",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:performance": "node scripts/run-performance.mjs"
  },
  "dependencies": {
    "@base-ui/react": "1.9.0",
    "@mdx-js/loader": "^3.1.1",
    "@mdx-js/react": "^3.1.1",
    "@next/mdx": "16.4.2",
    "@sentry/core": "11.8.0",
    "@sentry/nextjs": "11.8.0",
    "@tanstack/react-table": "^9.3.1",
    "@upstash/redis": "^1.39.0",
    "@vercel/analytics": "^2.0.1",
    "@vercel/speed-insights": "^2.0.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.61.0",
    "next": "16.4.2",
    "next-themes": "^0.4.6",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-email": "^6.11.3",
    "recharts": "^3.10.1",
    "resend": "^6.34.1",
    "stripe": "^23.0.1",
    "tailwind-merge": "^3.7.0"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@mdx-js/mdx": "^3.1.1",
    "@next/eslint-plugin-next": "16.4.2",
    "@playwright/test": "1.64.1",
    "@react-email/ui": "^6.11.3",
    "@tailwindcss/postcss": "^4.3.3",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/mdx": "^2.0.14",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitest/eslint-plugin": "^1.6.28",
    "chrome-launcher": "1.2.2",
    "eslint": "9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-check-file": "^3.3.2",
    "eslint-plugin-import-x": "^4.17.1",
    "eslint-plugin-jest-dom": "^5.10.1",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-playwright": "^2.12.1",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-testing-library": "^7.16.2",
    "globals": "17.13.0",
    "husky": "^9.1.7",
    "jsdom": "^30.1.3",
    "lighthouse": "13.5.0",
    "lint-staged": "^17.6.0",
    "msw": "^3.0.3",
    "prettier": "^3.9.10",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "tailwindcss": "^4.3.3",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.0",
    "vitest": "^5.0.5",
    "yaml": "2.9.1"
  },
  "type": "module",
  "overrides": {
    "@react-email/ui": {
      "next": "$next"
    }
  },
  "lint-staged": {
    "*": "prettier --check --ignore-unknown",
    "*.{js,cjs,mjs,jsx,ts,tsx}": "eslint --max-warnings=0 --cache --cache-location node_modules/.cache/eslint"
  },
  "packageManager": "npm@12.2.1",
  "allowScripts": {
    "esbuild@0.28.2": true,
    "unrs-resolver@1.12.2": true,
    "fsevents@2.3.3": true
  }
}
